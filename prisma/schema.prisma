generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WeddingRSVP {
  id                  String   @id @default(uuid())
  guestName           String   @map("guest_name")
  phoneNumber         String?  @map("phone_number")
  attendance          String   @default("Pending") // "Yes", "No", "Maybe", "Pending"
  guestCount          Int      @default(1)         @map("guest_count")
  welcomeDrink        String?  @map("welcome_drink")
  foodPreference      String?  @map("food_preference")
  roomPreference      String?  @map("room_preference")
  dietaryRestrictions String?  @map("dietary_restrictions")
  notes               String?  @map("notes")
  coupleNames         String?  @default("Rishabh & Anjali") @map("couple_names")
  callId              String?  @map("call_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  @@map("wedding_rsvps")
}
